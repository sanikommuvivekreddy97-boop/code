{
  "name": "sengoku",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "tsx scripts/preinstall.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "imagine": "tsx scripts/imagine.ts",
    "build:analyze": "cross-env ANALYZE=true pnpm run build",
    "start": "next start",
    "clean": "tsx scripts/clean.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "circular-check": "tsx scripts/check-circular-deps.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:file-size": "tsx scripts/check-file-size.ts",
    "check:translations": "tsx scripts/check-translations.ts",
    "check:styles": "cross-env CHECK_STYLES_STRICT=0 tsx scripts/check-styles.ts",
    "check:styles:working": "cross-env CHECK_STYLES_STRICT=0 tsx scripts/check-styles.ts --base HEAD",
    "check:redesign-tokens": "tsx scripts/check-redesign-tokens.ts",
    "test": "tsx --test $(find app lib -name '*.test.ts')",
    "test:hooks": "node --test scripts/hooks/*.test.mjs",
    "pixel-diff": "tsx scripts/pixel-diff.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run circular-check && pnpm run check:redesign-tokens && pnpm run check:translations && pnpm run check:styles:working && pnpm run test",
    "test:build": "pnpm run validate && pnpm run build",
    "lighthouse": "tsx scripts/lighthouse-local.ts",
    "lighthouse:ci": "lhci autorun",
    "shot": "tsx scripts/shot.ts",
    "prepare": "husky",
    "dev:s": "node scripts/server.js"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@lottiefiles/dotlottie-react": "^0.17.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/nextjs": "^10",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.5.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.12.2",
    "botid": "^1.5.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "heic-to": "^1.3.0",
    "html2pdf.js": "^0.14.0",
    "immer": "^10.2.0",
    "js-cookie": "^3.0.5",
    "ldrs": "^1.1.9",
    "lucide-react": "^0.548.0",
    "next": "16.4.6",
    "next-intl": "^4.3.9",
    "nextjs-toploader": "^3.9.17",
    "p-limit": "^7.2.0",
    "posthog-js": "^1.383.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.18.8",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dpdm": "^3.14.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.7",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "lqip-modern": "^2.2.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "puppeteer-core": "^24.23.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "zod": "^4.1.11"
  },
  "browserslist": [
    "iOS >= 12",
    "Safari >= 12",
    "Chrome >= 90",
    "Firefox >= 88",
    "Edge >= 90"
  ]
}
